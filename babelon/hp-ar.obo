[Term]
id: HP:0001889
name: Megaloblastic anemia
synonym: "فَقْرُ الدَّمِ الضَّخْمُ الأَرومات" EXACT [PAVS:AR]
synonym: "أنيميا الأرومات الضخمة" RELATED [PAVS:AR]
