synonym: "Reversible kidney failure" EXACT layperson [https://orcid.org/0000-0001-6908-9849]
synonym: "Reversible renal failure" EXACT layperson []
xref: UMLS:C1843276
is_a: HP:0000083 ! Renal insufficiency

