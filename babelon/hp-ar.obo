[Term]
id: HP:0011324
name: Multiple suture craniosynostosis
synonym: "التحام متعدد الدروز القحفية" EXACT [PAVS:AR]
synonym: "التحام عدة دروز في الجمجمة" RELATED [PAVS:AR]
