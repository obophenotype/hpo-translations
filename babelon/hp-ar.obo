[Term]
id: HP:0000010
name: Recurrent urinary tract infections
synonym: "التهابات المسالك البولية المتكررة" EXACT [PAVS:AR]
synonym: "التهابات متكررة في المسالك البولية" RELATED [PAVS:AR]
