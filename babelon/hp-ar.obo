[Term]
id: HP:0002043
name: Esophageal stricture
synonym: "تضيق المريء" EXACT [PAVS:AR]
synonym: "تضيق المريء بسبب الالتهاب والأنسجة المتندبة" RELATED [PAVS:AR]
