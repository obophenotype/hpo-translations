synonym: "Delayed closure of the fontanelles" EXACT []
synonym: "Delayed cranial suture closure" EXACT layperson []
synonym: "Delayed fontanel closure" EXACT []
synonym: "Delayed fontanelle closure" EXACT []
synonym: "Late closing fontanelles" EXACT []
synonym: "Late closure of fontanelle" EXACT []
synonym: "Late-closing fontanelle" EXACT []
synonym: "Open sutures" EXACT []
