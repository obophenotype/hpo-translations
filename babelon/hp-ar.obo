[Term]
id: HP:0500106
name: Isolated systolic hypertension
synonym: "ارتفاع ضغط الدم الانقباضي المعزول" EXACT [PAVS:AR]
synonym: "ضغط دم انقباضي مرتفع فقط" RELATED [PAVS:AR]
