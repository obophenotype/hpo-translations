[Term]
id: HP:0100708
name: Abnormal microglia morphology
synonym: "شذوذ نسيجي لخلايا الدبق الصغيرة" EXACT [PAVS:AR]
synonym: "تشوه في خلايا الدبق الصغيرة" RELATED [PAVS:AR]
