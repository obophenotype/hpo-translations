def: "An abnormally increased ratio of the concentrations of reverse T3 to T3 in the blood circulation." [PMID:29883303]
is_a: HP:0031508 ! Abnormal circulating thyroid hormone concentration
property_value: dc:date "2022-06-26T21:08:42Z" xsd:dateTime
property_value: terms:creator https://orcid.org/0000-0002-0736-9199

