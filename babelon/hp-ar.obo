[Term]
id: HP:0010602
name: Type 2 muscle fiber predominance
synonym: "غلبة ألياف العضلات من النوع 2" EXACT [PAVS:AR]
synonym: "غلبة النوع الثاني من الألياف العضلية" RELATED [PAVS:AR]
