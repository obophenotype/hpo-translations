xref: SNOMEDCT_US:418035005
xref: UMLS:C0152227
is_a: HP:0000632 ! Lacrimation abnormality
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
creation_date: 2009-05-02T10:52:28Z

