alt_id: HP:0008199
alt_id: HP:0008201
def: "Deficiency of parathyroid hormone with congenital onset." [https://orcid.org/0000-0002-0538-4547, https://orcid.org/0000-0002-0736-9199]
synonym: "Neonatal hypoparathyroidism" EXACT []
