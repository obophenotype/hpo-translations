property_value: terms:creator https://orcid.org/0009-0006-4530-3154
creation_date: 2010-12-27T05:17:57Z

[Term]
id: HP:0100600
name: Penoscrotal transposition
synonym: "إزاحة القضيب وكيس الصفن" EXACT [PAVS:AR]
synonym: "تبديل موضع القضيب وكيس الصفن" RELATED [PAVS:AR]
